# Copy this file to a new file named .env and put your key there.
# NEVER put a real key in .env.example: this file is tracked by Git.
# Restart the server after editing .env.

# Required for live research, writing, the Assistant and images.
# Leave empty to run in demo mode (no paid API calls).
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
# OPENAI_RESEARCH_MODEL=gpt-4.1
# OPENAI_WRITER_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-2
# Used by the Classic view:
OPENAI_MODEL=gpt-4.1-mini

PORT=8080

# Optional: path to the active brand profile JSON.
# BRAND_PROFILE=brand-profile.json

# Required on hosted deployments so a public URL cannot spend your key.
# APP_PASSWORD=

# Instagram publishing (Instagram API with Instagram Login).
# Leave both blank for a labelled dry-run. Never put a real token in this file.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional Graph version. Default is v26.0.
# INSTAGRAM_GRAPH_VERSION=v26.0
# Public https origin Instagram can use to download a generated JPEG.
# Example, while a tunnel is pointed at this server: https://your-demo.ngrok.io
# PUBLIC_BASE_URL=
